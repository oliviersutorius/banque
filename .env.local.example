# Variables du poste local, lues par router.php (serveur « php -S ») : copier ce fichier en .env.local.
# Sans effet en ligne : le serveur web appelle directement api/index.php, et la double authentification n'est de
# toute façon désactivable que sur localhost, en HTTP, depuis la machine elle-même.
# Une variable définie dans le shell est prioritaire. Chemins absolus (« ~ » n'est pas remplacé).

# Mot de passe seul sur le poste local (compte créé avec « php api/bin/compte.php init --sans-totp »)
BANQUE_TOTP=desactive

# Ou, avec la double authentification : clé de chiffrement (php api/bin/cle.php /home/<vous>/.config/banque-cle)
# BANQUE_CLE_FICHIER=/home/<vous>/.config/banque-cle

# Autre dossier de données (essais)
# BANQUE_DATA_DIR=/tmp/banque-essai
